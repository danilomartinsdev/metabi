# Copie para .env e preencha. Nunca faça commit do .env.
# Segredo do JWT (mínimo 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ADMIN_EMAIL=admin@metahospitalar.com.br
# Hash bcrypt da senha. Gere com: npm run hash-password -- "senha-forte"
# Mantenha as aspas simples: o hash contém "$".
ADMIN_PASSWORD_HASH=''
# true só quando o site estiver atrás de HTTPS
COOKIE_SECURE=false
